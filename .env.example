# Copy to .env (never commit .env). Values here are examples.
APP_ENV=production            # development shows PHP errors; production hides them
SITE_URL=https://nido-entruempelung.de

# Contact form mail. Without SMTP_HOST the server's PHP mail() is used.
MAIL_TO=info@nido-entruempelung.de
MAIL_FROM=noreply@nido-entruempelung.de
MAIL_FROM_NAME="Nido Entrümpelung Website"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls               # tls (STARTTLS, port 587) | ssl (port 465) | none
SMTP_USER=
SMTP_PASS=

# First admin login is "admin" / "ChangeMe-2026!" and MUST be changed at first login.
# Optional: override the initial password BEFORE the first request creates the database.
# ADMIN_INITIAL_PASSWORD=

# DB_PATH=/absolute/path/to/nido.sqlite   # default: storage/nido.sqlite
TRUST_PROXY=1                 # use X-Forwarded-For for client IP (Hostinger proxy)
